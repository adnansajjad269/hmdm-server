# Grafana file-provisioned alert rules — rendered by install.sh with an explicit
# envsubst variable list (${BATTERY_WARN} ${BATTERY_CRIT} ${ONLINE_THRESHOLD_SECONDS})
# so Grafana macros like $__timeFilter are untouched. OFFLINE_ALERT_SECONDS is no
# longer used here.
# UIDs are hardcoded so re-provisioning updates rules instead of duplicating them.
# The folder "HMDM Stats" (uid hmdm-stats) is created by the dashboard provider.
#
# The tiered "Offline devices report" used to live here as a Grafana alert rule
# (interval: 4h) fanned out through a webhook contact point + Go notification
# template. It was retired (see snapshot/offline_report.py) because Grafana's rule
# `interval` (how often the query re-runs) and Alertmanager's `repeat_interval`
# (a separate clock that just re-sends the LAST notification for an unresolved
# alert, without re-querying) inevitably drift out of phase when both are set to
# the same 4h -- a repeat-interval resend can fire with stale, pre-recovery data
# moments before the next real evaluation would have caught the device coming
# back online. A plain cron job that queries fresh data on every run has no such
# state to drift.
apiVersion: 1

groups:
  - orgId: 1
    name: hmdm-fleet
    folder: HMDM Stats
    interval: 5m
    rules:
      - uid: hmdm-battery-warn
        title: Battery low (warn tier)
        condition: C
        for: 0s
        noDataState: OK
        execErrState: Alerting
        labels:
          severity: warning
          source: hmdm-stats
        annotations:
          summary: "Device {{ $labels.device_number }} battery below ${BATTERY_WARN}% while online and not charging."
        data:
          - refId: A
            relativeTimeRange: { from: 21600, to: 0 }
            datasourceUid: hmdm-postgres
            model:
              refId: A
              format: table
              rawQuery: true
              rawSql: "WITH latest AS (SELECT DISTINCT ON (device_number) device_number, battery_level, charging, online FROM device_status_history ORDER BY device_number, sampled_at DESC) SELECT device_number, battery_level FROM latest WHERE online AND charging IS NULL AND battery_level IS NOT NULL"
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: lt, params: [${BATTERY_WARN}] }

      - uid: hmdm-battery-crit
        title: Battery critically low (freeze tier)
        condition: C
        for: 0s
        noDataState: OK
        execErrState: Alerting
        labels:
          severity: critical
          source: hmdm-stats
        annotations:
          summary: "Device {{ $labels.device_number }} battery below ${BATTERY_CRIT}% — FreeKiosk freeze tier."
        data:
          - refId: A
            relativeTimeRange: { from: 21600, to: 0 }
            datasourceUid: hmdm-postgres
            model:
              refId: A
              format: table
              rawQuery: true
              rawSql: "WITH latest AS (SELECT DISTINCT ON (device_number) device_number, battery_level, charging, online FROM device_status_history ORDER BY device_number, sampled_at DESC) SELECT device_number, battery_level FROM latest WHERE online AND charging IS NULL AND battery_level IS NOT NULL"
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: lt, params: [${BATTERY_CRIT}] }

      - uid: hmdm-data-stale
        title: Snapshot pipeline stale
        condition: C
        for: 0s
        noDataState: Alerting
        execErrState: Alerting
        labels:
          severity: critical
          source: hmdm-stats
        annotations:
          summary: "No new device_status_history rows for over ${ONLINE_THRESHOLD_SECONDS} seconds — the snapshot cron job is not writing. Check /var/log/hmdm-stats/snapshot.log."
        data:
          - refId: A
            relativeTimeRange: { from: 21600, to: 0 }
            datasourceUid: hmdm-postgres
            model:
              refId: A
              format: table
              rawQuery: true
              rawSql: "SELECT COALESCE(extract(epoch FROM (now() - max(sampled_at))), 999999) AS staleness_seconds FROM device_status_history"
          - refId: B
            datasourceUid: __expr__
            model:
              refId: B
              type: reduce
              expression: A
              reducer: last
          - refId: C
            datasourceUid: __expr__
            model:
              refId: C
              type: threshold
              expression: B
              conditions:
                - evaluator: { type: gt, params: [${ONLINE_THRESHOLD_SECONDS}] }

# File-provisioning only adds/updates rules matching a UID present above -- it does NOT
# delete a rule whose UID disappeared from an earlier version of this file. Both of
# these predate the current rule set and must be explicitly retired here, or they keep
# firing forever alongside it:
#   - hmdm-offline-1h: the old single-threshold "Device offline too long" rule.
#   - hmdm-offline-report: the tiered "Offline devices report" rule, replaced by the
#     standalone cron job in snapshot/offline_report.py (see the comment above).
deleteRules:
  - orgId: 1
    uid: hmdm-offline-1h
  - orgId: 1
    uid: hmdm-offline-report
